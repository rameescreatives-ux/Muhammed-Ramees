{
  "name": "coroli-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Coroli (ADVOC) bilingual static website. No dependencies, edit content then run the build.",
  "scripts": {
    "build": "node build.mjs",
    "build:preview": "SITE_NOINDEX=1 node build.mjs",
    "serve": "node build.mjs && npx --yes serve dist -l 4173",
    "build:hostinger": "TARGET=hostinger node build.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": { "node": ">=18" }
}
