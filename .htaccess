# ============================================================================
# SHADOWX STUDIOS — Apache configuration (Hostinger)
# ============================================================================

# Serve index.php before index.html
DirectoryIndex index.php index.html

# ---------------------------------------------------------------- security --
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Hide PHP version
<IfModule mod_php.c>
  php_flag expose_php off
</IfModule>

# Block access to dotfiles and backups
<FilesMatch "^\.|\.(bak|old|tmp|log|sql|json\.tmp)$">
  Require all denied
</FilesMatch>
# projects.json itself is served through PHP only — never directly
<Files "projects.json">
  Require all denied
</Files>

# ------------------------------------------------------------- clean URLs --
RewriteEngine On

# force https (comment out if you are testing without SSL)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# /blog/slug  ->  /blog/slug/index.html   (already real folders, nothing to do)
# /about      ->  /about.php              (future-proofing)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [L]

# ---------------------------------------------------------------- caching --
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json
</IfModule>
